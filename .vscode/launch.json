{
  "version": "0.2.0",
  "configurations": [
    

    {
      "name": "Debug Premium POS Integration API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Premium POS Integration API",
      "program": "${workspaceFolder}/PremiumposIntegrationApi/bin/Debug/net10.0/PremiumposIntegrationApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/PremiumposIntegrationApi",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7196;http://localhost:5137"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/health"
      }
    }
  ]
}
